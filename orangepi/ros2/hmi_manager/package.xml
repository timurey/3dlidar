<?xml version="1.0"?>
<package format="3">
  <name>hmi_manager</name>
  <version>0.1.0</version>
  <description>CYD HMI manager: serial bridge between ESP32 touchscreen and ROS2 bag recording</description>
  <maintainer email="taipov@gmail.com">openclaw</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
